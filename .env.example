# Catovoluntarios Backend - Variables de Entorno Modelo
PORT=3000
NODE_ENV=development

# Configuración de CORS (orígenes permitidos separados por coma)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Base de Datos PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=catovoluntarios_db
DATABASE_SSL=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catovoluntarios_db?schema=public

# Seguridad y Autenticación JWT
JWT_SECRET=super_secret_catovoluntarios_jwt_key_ucb_2026
JWT_EXPIRES_IN=7d

# =========================================================================
# CLOUDFLARE R2 - ALMACENAMIENTO DE ARCHIVOS EN LA NUBE (Compatible con S3)
# =========================================================================
# 1. R2_ACCOUNT_ID: En tu Cloudflare Dashboard -> R2 -> Overview (Panel derecho: "Account ID")
R2_ACCOUNT_ID=tu_cloudflare_account_id

# 2. R2_ACCESS_KEY_ID y R2_SECRET_ACCESS_KEY:
#    En Cloudflare Dashboard -> R2 -> "Manage R2 API Tokens" -> "Create API Token"
#    Permisos: Object Read & Write. Copia el "Access Key ID" y "Secret Access Key".
R2_ACCESS_KEY_ID=tu_r2_access_key_id
R2_SECRET_ACCESS_KEY=tu_r2_secret_access_key

# 3. R2_BUCKET_NAME: El nombre del bucket creado en Cloudflare R2
R2_BUCKET_NAME=catovoluntarios-documentos

# 4. R2_PUBLIC_URL: URL pública o dominio personalizado configurado para el bucket
#    Ejemplo con dominio público de Cloudflare: https://pub-xxxxxxxxxxxxxxxx.r2.dev
#    O con dominio propio: https://archivos.catovoluntarios.ucb.bo
R2_PUBLIC_URL=https://pub-tu_bucket_hash.r2.dev

# =========================================================================
# RESEND - SERVICIO DE ENVÍO TRANSACCIONAL DE CORREO (https://resend.com)
# =========================================================================
# 1. RESEND_API_KEY: Regístrate en https://resend.com y genera tu API Key en:
#    https://resend.com/api-keys (comienza con "re_")
RESEND_API_KEY=re_tu_api_key_aqui

# 2. Remitente del correo. En modo prueba puedes usar onboarding@resend.dev
#    Al verificar un dominio oficial en Resend, usa por ejemplo: Pastoral UCB <pastoral@tudominio.bo>
RESEND_FROM_EMAIL=Catovoluntarios UCB <onboarding@resend.dev>

# Parámetros de Negocio Pastoral UCB
MAX_SUBJECTS_ALLOWED=6
INSURANCE_POLICY_CODE=APC-7083
MIN_HOURS_SEMESTER=40
