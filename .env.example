# Catovoluntarios Backend - Variables de Entorno Modelo
PORT=3000
NODE_ENV=development

# Configuración de CORS (orígenes permitidos separados por coma)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Base de Datos PostgreSQL
# Si usas Neon.tech o Supabase, coloca DATABASE_SSL=true
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=catovoluntarios_db
DATABASE_SSL=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catovoluntarios_db?schema=public

# Seguridad y Autenticación JWT
JWT_SECRET=super_secret_catovoluntarios_jwt_key_ucb_2026
JWT_EXPIRES_IN=7d

# Parámetros de Negocio Pastoral UCB
MAX_SUBJECTS_ALLOWED=6
INSURANCE_POLICY_CODE=APC-7083
MIN_HOURS_SEMESTER=40
